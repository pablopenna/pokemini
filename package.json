{
  "name": "pokemini",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "GAME_DEBUG_MENU=true vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "scraperoute": "node src/scripts/scrape-routes/scrape-routes.ts",
    "scrapeall": "node src/scripts/scrape-routes/scrape-routes.ts --id route1 --crawl",
    "scrapepkmn": "node src/scripts/scrape-pkmn/scrape-pkmn.ts",
    "scrapeallpkmn": "node src/scripts/scrape-pkmn/scrape-pkmn.ts --all",
    "scrapepkmnsprite": "node src/scripts/scrape-pkmn/scrape-sprites.ts",
    "scrapeallpkmnsprites": "node src/scripts/scrape-pkmn/scrape-sprites.ts --all",
    "scrapeitem": "node src/scripts/scrape-items/scrape-items.ts",
    "scrapeallitems": "node src/scripts/scrape-items/scrape-items.ts --all",
    "generateitemids": "node src/scripts/generate-item-ids.ts",
    "rescraperoutes": "for f in src/data/routes/*.json; do node src/scripts/scrape-routes/scrape-routes.ts --id \"$(basename \"$f\" .json)\" --force; done"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "svelte-check-native": "^1.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@pkmn/client": "^0.7.3",
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@pkmn/img": "^0.3.4",
    "@pkmn/randoms": "^0.10.11",
    "@pkmn/sim": "^0.10.11",
    "@pkmn/view": "^0.7.3",
    "svelte": "^5.57.2"
  }
}
